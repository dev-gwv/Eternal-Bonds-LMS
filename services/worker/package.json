{
  "name": "@ipc/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/registry.ts",
  "exports": {
    ".": "./src/registry.ts",
    "./env": "./src/env.ts"
  },
  "scripts": {
    "dev": "bun --watch --env-file=../../.env src/main.ts",
    "start": "bun --env-file=../../.env src/main.ts",
    "run-job": "bun --env-file=../../.env src/main.ts run",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "start:prod": "bun src/main.ts"
  },
  "dependencies": {
    "@ipc/db": "workspace:*",
    "@ipc/domain": "workspace:*",
    "drizzle-orm": "^0.44.6",
    "jose": "^6.2.12",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0"
  }
}
