# The API this transcoder takes jobs from.
API_URL=https://eternal-bonds-api.dev-d9b.workers.dev
# Must match the API's TRANSCODER_SECRET (wrangler secret).
TRANSCODER_SECRET=

# An R2 API token with "Object Read & Write" on the one bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=eb-videos

# ultrafast | superfast | veryfast | faster | fast | medium
# Slower presets make smaller files at the same quality, and take longer.
X264_PRESET=veryfast
# Threads ffmpeg may use. 0 = all cores. 2 matches the container's CPU cap.
FFMPEG_THREADS=2
