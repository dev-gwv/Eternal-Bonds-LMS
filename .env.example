# ─── Supabase ────────────────────────────────────────────────────────────────
# Project settings → API. The service role key is server-only: it bypasses RLS.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Project settings → Database → Connection string → "Session pooler".
# Leave empty to run the API on seed data with no database at all.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ─── API ─────────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
# Web origins only. Native apps send no Origin and are handled in lib/cors.ts.
ALLOWED_ORIGINS=http://localhost:5173
STORAGE_BUCKET=ipc-media
CRON_SECRET=change-me

# Video stays behind the provider interface (PLAN §2)
VIDEO_PROVIDER=none
VIDEO_API_TOKEN=

# ─── Web (Vite needs the VITE_ prefix) ───────────────────────────────────────
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
# Empty in dev: Vite proxies /v1 to the API. Set for a separately hosted API.
VITE_API_URL=

# ─── Test sign-in (temporary) ────────────────────────────────────────────────
# Set BOTH to put a one-click "skip login" button on the sign-in page. It signs
# in to a real account and gets a real session, so RLS still decides what that
# account can see — it is a shortcut past the OTP, not past authorisation.
#
# It is still a password compiled into a public bundle. Anyone who opens the
# site can click it. Use a throwaway free-tier account, and rebuild without
# these before real members arrive.
#
# Leave both empty and the button does not exist in the bundle at all.
VITE_DEV_LOGIN_EMAIL=
VITE_DEV_LOGIN_PASSWORD=

# ─── Video provider ──────────────────────────────────────────────────────────
# `none` keeps the file in Supabase Storage and serves a signed progressive
# MP4 — fine to develop against, not adaptive bitrate. See docs/video.md.
#   cloudflare → VIDEO_ACCOUNT_ID + an API token with Stream:Edit
#   bunny      → VIDEO_LIBRARY_ID + the library's API key
VIDEO_ACCOUNT_ID=
VIDEO_LIBRARY_ID=
# Cloudflare: customer-<code>.cloudflarestream.com. Bunny: the pull zone host.
VIDEO_DELIVERY_HOST=
# Cloudflare: the signing key id and its PKCS#8 private key.
# Bunny: leave the id empty and put the pull zone token key in the PEM field.
VIDEO_SIGNING_KEY_ID=
VIDEO_SIGNING_KEY_PEM=
VIDEO_WEBHOOK_SECRET=
VIDEO_MAX_SECONDS=14400

# ─── Payments ────────────────────────────────────────────────────────────────
# web_only ships in the store builds: Apple and Google take a share of in-app
# purchases, so memberships are bought on the website (PLAN §7).
BILLING_MODE=web_only
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Email ───────────────────────────────────────────────────────────────────
# `console` logs what it would have sent. Do not switch to a real provider
# before SPF, DKIM and DMARC exist for the sending domain — the first campaign
# from an unverified domain is how a club's address gets blocklisted for good.
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=Eternal Bonds <no-reply@example.com>
EMAIL_REPLY_TO=

# ─── Push ────────────────────────────────────────────────────────────────────
# FCM HTTP v1, from a service account JSON. iOS rides on FCM rather than APNs
# directly, so there is one code path and one credential.
PUSH_PROVIDER=console
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Where links in emails and push notifications point.
APP_URL=http://localhost:5173
