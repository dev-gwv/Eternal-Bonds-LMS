{
  // ⚠️ `wrangler deploy` is an UPSERT. A Worker that already exists under this
  // name is silently overwritten — no prompt, no warning, and the output looks
  // identical to a fresh deploy. The name must therefore be unique across the
  // whole Cloudflare account, not just this project.
  //
  // This one was "ipc-web" and it overwrote an unrelated CRM frontend. Check
  // before renaming:
  //   bun x wrangler deployments list --name <the-new-name>
  // Deployments you do not recognise mean the name is taken.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "eternal-bonds-web",
  "compatibility_date": "2026-09-01",

  // A static bundle, not a Worker: Vite has already produced dist/, and there
  // is no server-side rendering to do.
  "assets": {
    "directory": "./dist",
    // The router owns the URL space, so anything that is not a file is the app.
    "not_found_handling": "single-page-application"
  }

  // Nothing secret belongs here. VITE_* values are compiled into the bundle at
  // build time and are readable by anyone who opens devtools — which is fine
  // for VITE_SUPABASE_URL and the publishable key, and never acceptable for
  // the service-role key or DATABASE_URL.
}
